{
  "manifest_version": 3,
  "name": "BlurReact · Oscuramento persistente",
  "version": "1.0.0",
  "version_name": "1.0.0-beta.2",
  "description": "Seleziona più elementi e mantieni gli oscuramenti dopo refresh, riapertura e aggiornamenti React.",
  "permissions": ["storage", "webNavigation", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "BlurReact"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"], "js": ["content.js"],
    "run_at": "document_start", "all_frames": true, "match_about_blank": true,
    "match_origin_as_fallback": true
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
